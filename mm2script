local function getRole(plr)
	local char = plr.Character
	if not char then return "Unknown" end
	local pack = plr:FindFirstChild("Backpack")
	if (pack and pack:FindFirstChild("Knife")) or char:FindFirstChild("Knife") then return "Murderer" end
	if (pack and pack:FindFirstChild("Gun")) or char:FindFirstChild("Gun") then return "Sheriff" end
	return "Innocent"
end

local function roleColor(role)
	if role == "Murderer" then return C.Red end
	if role == "Sheriff" then return C.Blue end
	return C.Green
end

local function fireDamage(targetChar)
	pcall(function()
		local remotes = ReplicatedStorage:FindFirstChild("Remotes") or ReplicatedStorage
		for _, name in ipairs({"ShootGun", "KnifeHit", "Hit", "Damage"}) do
			local r = remotes:FindFirstChild(name, true)
			if r and r:IsA("RemoteEvent") then r:FireServer(targetChar) return end
		end
	end)
end

local function getMyRoot()
	return player.Character and player.Character:FindFirstChild("HumanoidRootPart")
end

local function tpTo(pos)
	local hrp = getMyRoot()
	if hrp then hrp.CFrame = CFrame.new(pos + Vector3.new(0,3.5,0)) end
end

local function findDroppedGun()
	for _, obj in ipairs(workspace:GetDescendants()) do
		local n = obj.Name:lower()
		if n == "gundrop" or n == "gun" or n:find("gundrop") then
			local part = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart", true)
			if part and not Players:GetPlayerFromCharacter(part.Parent) then return part end
		end
	end
	return nil
end

