-- silent aim wired into camera (kept local — no remote spoofing needed)
RunService.RenderStepped:Connect(function()
	local target = nil
	if state.Aim.Aimbot or state.Aim.SilentAim then
		local t = getAimTarget()
		if t then target = t.part end
	end
	if target then
		local goal = target.Position
		if state.Aim.Prediction and target.Parent then
			local hrp = target.Parent:FindFirstChild("HumanoidRootPart")
			if hrp then goal = goal + hrp.AssemblyLinearVelocity * 0.13 end
		end
		if state.Aim.SilentAim then
			-- silent: pin the camera's ray to the target part with no smoothing
			camera.CFrame = CFrame.new(camera.CFrame.Position, goal)
		else
			local smooth = math.clamp(state.Aim.Smooth, 0, 0.95)
			camera.CFrame = camera.CFrame:Lerp(CFrame.new(camera.CFrame.Position, goal), 1 - smooth)
		end
	end
	-- only fight the game's FOV when the player explicitly asked for a change
	if state.Player.CameraFOV and state.Player.CameraFOV ~= 70 then
		camera.FieldOfView = state.Player.CameraFOV
	end
end)

