local function selectTab(btn)
	for b, info in pairs(tabButtons) do
		local sel = (b == btn)
		tw(b, 0.12, { BackgroundTransparency = sel and 0.65 or 1, BackgroundColor3 = C.Yellow })
		tw(info.Label, 0.12, { TextColor3 = sel and C.Yellow2 or C.White })
		tw(info.Stroke, 0.12, { Transparency = sel and 0 or 0.55 })
	end
	local d = tabButtons[btn].Data
	contentHeader.Text = d.Name
	contentDesc.Text = d.Info
	buildModules(d.Name)
end

for i, data in ipairs(TABS) do
	local btn = mk("TextButton", {
		Name = data.Name, Text = "", Size = UDim2.new(1, 0, 0, 26),
		BackgroundColor3 = C.Yellow, BackgroundTransparency = 1,
		AutoButtonColor = false, ClipsDescendants = true, LayoutOrder = i,
	}, tabsBox)
	round(btn, 6)
	local stroke = outline(btn, C.Yellow, 1.2, 0.55)
	local label = mk("TextLabel", {
		Text = data.Name, Font = Enum.Font.GothamMedium, TextSize = 12,
		TextColor3 = C.White, TextXAlignment = Enum.TextXAlignment.Left,
		BackgroundTransparency = 1, Position = UDim2.fromOffset(10, 0),
		Size = UDim2.new(1, -20, 1, 0), ZIndex = 2,
	}, btn)
	tabButtons[btn] = { Data = data, Label = label, Stroke = stroke }
	btn.MouseEnter:Connect(function()
		if contentHeader.Text ~= data.Name then tw(stroke, 0.1, { Transparency = 0.1 }) end
	end)
	btn.MouseLeave:Connect(function()
		if contentHeader.Text ~= data.Name then tw(stroke, 0.1, { Transparency = 0.55 }) end
	end)
	btn.MouseButton1Click:Connect(function() selectTab(btn) end)
end

-- floating icon
local iconHolder = mk("Frame", {
	Name = "FloatingIcon",
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.92, 0.5),
	Size = UDim2.fromOffset(52, 52),
	BackgroundTransparency = 1,
	Visible = false,
	ZIndex = 50,
}, gui)
local iconBadge, iconImg = makeLogo(iconHolder, 52, 12)
local iconBtn = mk("TextButton", {
	Text = "", Size = UDim2.fromScale(1, 1),
	BackgroundTransparency = 1, AutoButtonColor = false, ZIndex = 60,
}, iconHolder)
local iconScale = mk("UIScale", { Scale = 1 }, iconHolder)

local draggingIcon, iconMoved = false, false
local dragStart, startPos
iconBtn.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		draggingIcon = true
		iconMoved = false
		dragStart = input.Position
		startPos = iconHolder.Position
	end
end)
UserInputService.InputChanged:Connect(function(input)
	if not draggingIcon then return end
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
		local delta = input.Position - dragStart
		if delta.Magnitude > 6 then iconMoved = true end
		iconHolder.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
	end
end)
UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		if draggingIcon then
			draggingIcon = false
			if not iconMoved and iconHolder.Visible then
				iconHolder.Visible = false
				menu.Visible = true
				menuScale.Scale = 0.9
				tw(menuScale, 0.25, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
			end
		end
	end
end)

local function openMenu()
	iconHolder.Visible = false
	menu.Visible = true
	menuScale.Scale = 0.9
	tw(menuScale, 0.25, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
end

local function closeMenu()
	if not menu.Visible then return end
	menu.Visible = false
	iconHolder.Visible = true
	iconScale.Scale = 0.6
	tw(iconScale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	if iconImg then loadLogo(iconImg) end
end

closeBtn.MouseButton1Click:Connect(closeMenu)
makeDraggable(menu, topBar)

UserInputService.InputBegan:Connect(function(input, gp)
	if gp then return end
	if input.KeyCode == state.Settings.Keybind then
		if menu.Visible then closeMenu() else openMenu() end
	end
end)

selectTab(next(tabButtons))
openMenu()
refreshESP()

task.delay(0.8, function()
	if gui and gui.Parent then
		gui.Enabled = true
		if not menu.Visible and not iconHolder.Visible then openMenu() end
	end
end)
