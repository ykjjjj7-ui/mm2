-- ESP lifecycle
local espFolder = mk("Folder", { Name = "UL_ESP" }, gui)
local gunESPFolder = mk("Folder", { Name = "UL_GunESP" }, gui)
local tracerFolder = mk("Folder", { Name = "UL_Tracers" }, gui)
local espObjects = {}

local function destroyESPFor(plr)
	local t = espObjects[plr]
	if t then
		for _, inst in pairs(t) do pcall(function() inst:Destroy() end) end
		espObjects[plr] = nil
	end
end

local function clearESP()
	for plr in pairs(espObjects) do destroyESPFor(plr) end
	for _, c in ipairs(espFolder:GetChildren()) do c:Destroy() end
	for _, c in ipairs(tracerFolder:GetChildren()) do c:Destroy() end
end

local function clearGunESP()
	for _, c in ipairs(gunESPFolder:GetChildren()) do c:Destroy() end
end

local function createESPFor(plr)
	if not state.Visuals.ESP or plr == player then destroyESPFor(plr) return end
	local char = plr.Character
	local head = char and char:FindFirstChild("Head")
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not head or not hrp or not hum or hum.Health <= 0 then destroyESPFor(plr) return end
	local myRoot = getMyRoot()
	local dist = myRoot and (hrp.Position - myRoot.Position).Magnitude or 0
	if state.Visuals.MaxDistance > 0 and dist > state.Visuals.MaxDistance then destroyESPFor(plr) return end

	local role = getRole(plr)
	local col = state.Visuals.RoleESP and roleColor(role) or C.Yellow
	destroyESPFor(plr)
	espObjects[plr] = {}

