local function playTrack(id, name)
	state.Music.CurrentId = tostring(id)
	state.Music.CurrentName = name or ("ID " .. id)
	musicSound.SoundId = "rbxassetid://" .. tostring(id)
	musicSound.Volume = state.Music.Volume
	musicSound.PlaybackSpeed = state.Music.Pitch
	musicSound:Play()
	state.Music.Playing = true
end

local function stopTrack()
	musicSound:Stop()
	state.Music.Playing = false
end

local function setVolume(v)
	state.Music.Volume = math.clamp(v, 0, 1)
	musicSound.Volume = state.Music.Volume
end

local function setPitch(v)
	state.Music.Pitch = math.clamp(v, 0.5, 2)
	musicSound.PlaybackSpeed = state.Music.Pitch
end

